  "local_adaptations": [
    "original-page WBC and writeback accounting before any IPU BIO publication, once across retries",
    "embedded GC request lifetime, serialized worker pointer and admission generation",
    "closed freezer admission window and existing kthread_freezable_should_stop helper; no shared freezer changes",
    "checkpoint admission rwsem held through each queued completion; prepublication accounting and saved-next completion iteration",
    "independent nonblocking internal-write and s_umount worker protections; caller-context synchronous fallback without borrowed quota locks",
    "no CP/GC worker delegation cycle; cached OPU/IPU drain before both kinds of wait",
    "new CP worker allocated before remount quota activation changes; all post-start error exits undo it; old worker stop deferred until success"
  ],
  "options": {
    "gc_merge": {
      "default": false,
      "disable": "nogc_merge",
      "no_gc_worker": "direct GC fallback"
    },
    "checkpoint_merge": {
      "default": false,
      "disable": "nocheckpoint_merge",
      "queued_reason": "exact CP_SYNC only",
      "priority": "fixed IOPRIO_CLASS_BE/3",
      "freeze_or_umount_contention": "caller-context synchronous fallback"
    }
  },
