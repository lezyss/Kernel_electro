diff --git a/Kconfig b/Kconfig
--- a/Kconfig
+++ b/Kconfig
@@ -2,7 +2,8 @@
 
 config NOMOUNT
 	tristate "NoMount Path Redirection Subsystem"
-	default y
+	depends on KEYS
+	default n
 	help
 	  NoMount allows path redirection and virtual file injection
 	  without mounting filesystems. Useful for systemless modifications.
diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -1,24 +1,10 @@
-# Makefile for NoMount
+# SPDX-License-Identifier: GPL-2.0
+# Vendored NoMount: identity is recorded in UPSTREAM.json, not a Git probe.
+obj-$(CONFIG_NOMOUNT) += nomount.o
 
-ifeq ($(filter /%,$(src)),)
-NM_REAL_PATH := $(realpath $(srctree)/$(src))
-else
-NM_REAL_PATH := $(realpath $(src))
-endif
-
-NOMOUNT_COMMITS := $(shell \
-    d='$(NM_REAL_PATH)'; \
-    while [ -n "$$d" ] && [ "$$d" != "/" ] && [ ! -d "$$d/.git" ]; do d=$$(dirname "$$d"); done; \
-    if [ -d "$$d/.git" ] && git -C "$$d" remote get-url origin 2>/dev/null | grep -q 'nomount'; then \
-        git -C "$$d" rev-list --count HEAD 2>/dev/null; \
-    fi)
-
-ifneq ($(NOMOUNT_COMMITS),)
-ccflags-y += -DNOMOUNT_COMMIT_COUNT=\"$(NOMOUNT_COMMITS)\"
-endif
-
-obj-$(CONFIG_NOMOUNT) += nomount.o
-ccflags-y += -std=gnu11 -Wno-declaration-after-statement -O3 -fno-stack-protector
+# C11 is required by declarations in for-loops and cleanup-based RCU guards.
+# Retain the kernel's optimization and stack-protection choices.
+ccflags-y += -std=gnu11 -Wno-declaration-after-statement
 
 ifeq ($(shell grep -qE '\(\*[[:space:]]*__get\)' $(srctree)/include/linux/xattr.h 2>/dev/null && echo 1 || echo 0),1)
 ccflags-y += -DNM_HAS_XATTR__GET
