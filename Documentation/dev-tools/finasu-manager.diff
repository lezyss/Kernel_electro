+bool ksu_is_manager_package(const char *package)
+{
+	return !strcmp(package, KSU_PACKAGE_NAME) ||
+	       !strcmp(package, "com.kowx712.supermanager") ||
+	       !strcmp(package, "com.midori.supermanager") ||
+	       !strcmp(package, KSU_FINASU_PACKAGE_NAME);
+}
+
+int ksu_package_from_apk_path(char *package, const char *path)
+{
+	char directory[KSU_MAX_PACKAGE_NAME];
+	const char *end = strrchr(path, '/');
+	size_t length;
+
+	if (!end || strcmp(end, "/base.apk"))
+		return -EINVAL;
+	length = end - path;
+	if (length >= sizeof(directory))
+		return -ENAMETOOLONG;
+	memcpy(directory, path, length);
+	directory[length] = '\0';
+	return get_pkg_from_apk_dir_path(package, directory);
+}
+
 bool is_manager_apk(char *path)
 {
+	char package[KSU_MAX_PACKAGE_NAME];
+
+	if (ksu_package_from_apk_path(package, path) || !ksu_is_manager_package(package))
+		return false;
+
+	/* A FinaSU package must have FinaSU's key, not another accepted key. */
+	if (!strcmp(package, KSU_FINASU_PACKAGE_NAME))
+		return check_v2_signature(path, KSU_FINASU_CERT_SIZE, KSU_FINASU_CERT_SHA256);
+
 	// dummy.keystore
 	if (check_v2_signature(path, 0x363, "4359c171f32543394cbc23ef908c4bb94cad7c8087002ba164c8230948c21549"))
