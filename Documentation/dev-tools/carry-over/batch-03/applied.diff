+bool f2fs_is_gc_thread(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_gc_merge *merge = &sbi->gc_merge;
+	bool is_gc;
+
+	spin_lock(&merge->lock);
+	is_gc = current == merge->task;
+	spin_unlock(&merge->lock);
+	return is_gc;
