+static bool nm_is_pseudo_fs(struct super_block *sb)
+{
+    switch (sb->s_magic) {
+    case PROC_SUPER_MAGIC:
+    case SYSFS_MAGIC:
+    case DEVPTS_SUPER_MAGIC:
+    case DEBUGFS_MAGIC:
+    case TRACEFS_MAGIC:
+    case SECURITYFS_MAGIC:
+    case CGROUP_SUPER_MAGIC:
+#ifdef CGROUP2_SUPER_MAGIC
+    case CGROUP2_SUPER_MAGIC:
+#endif
+    case SELINUX_MAGIC:
+    case BPF_FS_MAGIC:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool nm_is_kernfs(struct super_block *sb)
+{
+    switch (sb->s_magic) {
+    case SYSFS_MAGIC:
+    case CGROUP_SUPER_MAGIC:
+#ifdef CGROUP2_SUPER_MAGIC
+    case CGROUP2_SUPER_MAGIC:
+#endif
+    case TRACEFS_MAGIC:
+    case SECURITYFS_MAGIC:
+    case BPF_FS_MAGIC:
+    case DEBUGFS_MAGIC:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool nm_dir_lookup_tolerates_cross_sb(struct super_block *sb)
+{
+    switch (sb->s_magic) {
+    case F2FS_SUPER_MAGIC:
+    case EXT4_SUPER_MAGIC:
+#if defined(EROFS_SUPER_MAGIC_V1) && BITS_PER_LONG == 64
+    case EROFS_SUPER_MAGIC_V1:
+#endif
+    case SQUASHFS_MAGIC:
+        return true;
+    default:
+        return false;
+    }
+}
