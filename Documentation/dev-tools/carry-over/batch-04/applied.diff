+int pico_snprintf(char *pDest, size_t cbDest, const char *pFormat, ...) {
+    va_list vl;
+    va_start(vl, pFormat);
+    int result = pico_vsnprintf(pDest, cbDest, pFormat, vl);
+    va_end(vl);
+    return result;
+}
