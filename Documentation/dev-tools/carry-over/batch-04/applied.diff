+{
+	WRITE_ONCE(ksu_manager_appid, appid == KSU_INVALID_APPID ?
+		   KSU_INVALID_APPID : appid % KSU_PER_USER_RANGE);
+}
+
+static inline void ksu_invalidate_manager_uid()
+{
+	WRITE_ONCE(ksu_manager_appid, KSU_INVALID_APPID);
