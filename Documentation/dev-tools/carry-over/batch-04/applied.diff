+static inline int ksu_selinux_get_sids()
+{
+	int err = security_secctx_to_secid("u:r:priv_app:s0:c512,c768", strlen("u:r:priv_app:s0:c512,c768"), &priv_app_sid);
+	if (!err)
+		pr_info("selinux_hide: priv_app_sid: %u\n", priv_app_sid);
+
+	if (!priv_app_sid)
+		return -1;
+
+	return 0;
