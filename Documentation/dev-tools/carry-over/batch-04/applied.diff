+	 * either way uid_t == kuid_t == ksu_kuid_t, so use a dummy struct
+	 * doesn't rly matter, just explicitness, an excuse to use ksu_kuid_t
+	 */
+	struct user_struct *(*fn_new)(ksu_kuid_t uid) = (void *)&alloc_uid;
+	ksu_kuid_t kuid = { .val = uid };
+	return fn_new(kuid);
