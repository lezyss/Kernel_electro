+	}
+	lock_mount_hash();
+	for (; mnt->mnt_parent && mnt != mnt->mnt_parent &&
+	       mnt->mnt_id >= DEFAULT_KSU_MNT_ID; mnt = mnt->mnt_parent) { }
+	if (!mnt->mnt.mnt_root || IS_ERR(mnt->mnt.mnt_root))
