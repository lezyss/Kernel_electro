+static inline int nm_drop_dentry(struct dentry *dentry, unsigned int flags, bool weak)
+{
+    if (flags & LOOKUP_RCU) return -ECHILD;
+    d_drop(dentry);
+    return weak ? -ESTALE : 0;
+}
