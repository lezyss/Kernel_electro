+	);
+}
+
+#elif defined(__arm__)
+__attribute__((naked))
+void __start(void) {
+	asm volatile(
+		"mov r0, sp\n"
+		"b prep_main\n"
+    );
+}
+
+#elif defined(__x86_64__)
+__attribute__((naked, section(".text.start"))) 
+void __start(void) {
+	asm volatile(
+		"mov %rsp, %rdi\n"
+		"jmp prep_main\n"
+	);
+}
+#elif defined(__i386__)
+__attribute__((naked, section(".text.start"))) 
+void __start(void) {
+	asm volatile(
+		"movl %esp, %eax\n"
+		"pushl %eax\n"
+		"call prep_main\n"
+	);
+}
+#endif
