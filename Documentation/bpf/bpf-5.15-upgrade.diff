+	old_run_ctx = bpf_set_run_ctx(&run_ctx.run_ctx);
+	while ((prog = bpf_prog_array_next_prog(array, item, cnt))) {
+		run_ctx.prog_item = item;
+		func_ret = run_prog(prog, ctx);
+		ret &= (func_ret & 1);
